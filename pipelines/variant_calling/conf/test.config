/*
 * Test profile: small chr21-subset data for fast dev iteration.
 * Swap these params for the full GIAB HG002 FASTQs + full GRCh38 reference
 * once the pipeline logic is validated end-to-end.
 *
 * NOTE: replace the placeholder URLs below with an actual nf-core/test-datasets
 * (or your own) chr21 subset before running — kept as placeholders here since
 * this was scaffolded without live internet access to verify exact asset paths.
 */

params {
    max_cpus   = 2
    max_memory = '6.GB'

    input        = "${projectDir}/assets/samplesheet_test.csv"
    genome_fasta = "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/sequence/genome.fasta"
    known_sites  = "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/germlineresources/dbsnp_138.hg38.vcf.gz"
}

process {
    executor = 'local'
    cpus     = 2
    memory   = '4 GB'
}

docker.enabled = true
