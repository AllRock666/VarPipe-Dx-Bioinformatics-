/*
 * AWS Batch profile — Phase 5.
 * Fill in your queue / bucket before use. The pipeline logic in main.nf and
 * modules/ is unchanged; only the executor and work directory move to AWS.
 */

params {
    outdir = 's3://YOUR-BUCKET/varpipe-dx/results'
}

aws {
    region = 'us-east-1'
    batch {
        cliPath = '/home/ec2-user/miniconda/bin/aws'
    }
}

process {
    executor = 'awsbatch'
    queue    = 'YOUR-AWS-BATCH-QUEUE'
}

workDir = 's3://YOUR-BUCKET/varpipe-dx/work'

docker.enabled = true
