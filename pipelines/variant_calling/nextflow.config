/*
 * VarPipe-Dx :: Phase 1 — WES Variant Calling Pipeline
 * FastQC -> fastp -> BWA-MEM -> MarkDuplicates -> BQSR -> {HaplotypeCaller, DeepVariant}
 *          -> Joint Genotyping -> Hard Filter -> MultiQC
 */

nextflow.enable.dsl = 2

params {
    // Input / output
    input           = null        // samplesheet CSV: sample,fastq_1,fastq_2
    outdir          = 'results'

    // Reference
    genome_fasta    = null
    known_sites     = null        // dbSNP / known indels VCF for BQSR

    // Toggle callers
    run_gatk        = true
    run_deepvariant = true

    // Misc
    max_cpus        = 8
    max_memory      = '16.GB'
}

profiles {
    standard {
        process.executor = 'local'
        docker.enabled    = true
    }

    test {
        includeConfig 'conf/test.config'
    }

    awsbatch {
        includeConfig 'conf/awsbatch.config'
    }
}

docker.runOptions = '-u $(id -u):$(id -g)'

process {
    errorStrategy = 'retry'
    maxRetries    = 1

    withName: 'FASTQC' {
        cpus      = 2
        memory    = '4 GB'
        container = 'biocontainers/fastqc:v0.11.9_cv8'
    }
    withName: 'FASTP' {
        cpus      = 4
        memory    = '4 GB'
        container = 'quay.io/biocontainers/fastp:0.23.4--h5f740d0_0'
    }
    withName: 'BWA_MEM' {
        cpus      = 8
        memory    = '16 GB'
        container = 'quay.io/biocontainers/bwa:0.7.17--hed695b0_7'
    }
    withName: 'MARK_DUPLICATES' {
        cpus      = 4
        memory    = '8 GB'
        container = 'broadinstitute/gatk:4.5.0.0'
    }
    withName: 'GATK_BQSR' {
        cpus      = 4
        memory    = '8 GB'
        container = 'broadinstitute/gatk:4.5.0.0'
    }
    withName: 'GATK_HAPLOTYPECALLER' {
        cpus      = 4
        memory    = '8 GB'
        container = 'broadinstitute/gatk:4.5.0.0'
    }
    withName: 'DEEPVARIANT' {
        cpus      = 8
        memory    = '16 GB'
        container = 'google/deepvariant:1.6.1'
    }
    withName: 'JOINT_GENOTYPING' {
        cpus      = 4
        memory    = '8 GB'
        container = 'broadinstitute/gatk:4.5.0.0'
    }
    withName: 'HARD_FILTER' {
        cpus      = 2
        memory    = '4 GB'
        container = 'broadinstitute/gatk:4.5.0.0'
    }
    withName: 'MULTIQC' {
        cpus      = 2
        memory    = '4 GB'
        container = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
    }
}

manifest {
    name        = 'varpipe-dx/variant-calling'
    description = 'WES variant calling: FastQC/fastp/BWA-MEM/GATK/DeepVariant, benchmarked against GIAB'
    version     = '0.1.0'
}
