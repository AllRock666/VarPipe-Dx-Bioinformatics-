/*
 * VarPipe-Dx :: Phase 3 — RNA-seq Differential Expression
 * FastQC -> Salmon (Quantification) -> DESeq2
 */

nextflow.enable.dsl = 2

params {
    input      = null
    transcriptome = null
    outdir     = 'results_rnaseq'
    
    // Testing defaults
    max_cpus   = 4
    max_memory = '8.GB'
}

profiles {
    standard {
        process.executor = 'local'
        docker.enabled   = true
    }

    test {
        params.input = "${projectDir}/assets/samplesheet_rnaseq.csv"
        // Small mock transcriptome or standard airway dataset subset
        params.transcriptome = "https://raw.githubusercontent.com/nf-core/test-datasets/rnaseq/reference/transcriptome.fasta"
    }
}

process {
    withName: 'FASTQC' {
        container = 'biocontainers/fastqc:v0.11.9_cv8'
        cpus = 2
    }
    withName: 'SALMON_INDEX' {
        container = 'combinelab/salmon:1.9.0'
        cpus = 2
    }
    withName: 'SALMON_QUANT' {
        container = 'combinelab/salmon:1.9.0'
        cpus = 4
    }
    withName: 'DESEQ2' {
        container = 'quay.io/biocontainers/bioconductor-deseq2:1.38.0--r42hf17093f_0'
        cpus = 2
    }
}
